[options]
suppress_default_binds = true
overlay = false
overlay_font = Iosevka NF:12
overlay_text = $(/home/kabir/.local/bin/imv-overlay "$imv_current_file")

[binds]
q = quit

<Left> = prev
<Right> = next
gg = goto 1
<Shift+G> = goto -1

h = prev
l = next

<Up> = zoom 1
<Down> = zoom -1

x = close
f = fullscreen
d = overlay
i = overlay
c = center
s = scaling next
<Shift+S> = upscaling next
a = zoom actual
r = reset

<period> = next_frame
<space> = toggle_playing
