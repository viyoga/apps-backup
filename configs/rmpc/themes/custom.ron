#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    default_album_art_path: None,
    show_song_table_header: true,
    draw_borders: true,
    browser_column_widths: [0, 55, 45],
    text_color: "#e6dfd3",
    tab_bar: (
        active_style: (fg: "#161311", bg: "#a2b574", modifiers: "Bold"),
        inactive_style: (fg: "#e6dfd3", modifiers: "Bold"),
    ),
    highlighted_item_style: (fg: "#a2b574", modifiers: "Bold"),
    current_item_style: (fg: "#a2b574", bg: "#26211e", modifiers: "Bold"),
    borders_style: (fg: "#e6dfd3", modifiers: "", border_symbols: Library("sharp")),
    highlight_border_style: (fg: "#a2b574"),
    symbols: (
        song: "󰝚 ",
        dir: " ",
        playlist: "󰲸 ",
        marker: "* ",
        ellipsis: "...",
        song_style: (fg: "#a2b574"),
        dir_style: (fg: "#e6dfd3", modifiers: ""),
    ),
    progress_bar: (
        symbols: ["", "|", "|", "⋮", ""],
        track_style: (fg: "#26211e"),
        elapsed_style: (fg: "#a2b574"),
        thumb_style: (fg: "#a2b574"),
        use_track_when_empty: false,
    ),
    scrollbar: (
        symbols: ["│", "█", "▲", "▼"],
        track_style: (fg: "#e6dfd3"),
        ends_style: (fg: "#a2b574"),
        thumb_style: (fg: "#a2b574"),
    ),
    song_table_format: [
        (
            prop: (kind: Property(Title), style: (fg: "#e6dfd3"),
                default: (kind: Text("Unknown"), style: (fg: "#e6dfd3"))),
            width: "55%",
            label_prop: (kind: Text("Title"), style: (fg: "#a2b574", modifiers: "Bold")),
        ),
        (
            prop: (kind: Property(Artist), style: (fg: "#e6dfd3"),
                default: (kind: Text("Unknown"), style: (fg: "#e6dfd3"))),
            width: "35%",
            label_prop: (kind: Text("Artist"), style: (fg: "#dfb26c", modifiers: "Bold")),
        ),
        (
            prop: (kind: Property(Duration), style: (fg: "#e6dfd3"),
                default: (kind: Text("-"), style: (fg: "#e6dfd3"))),
            width: "10%",
            label_prop: (kind: Text("Duration"), style: (fg: "#e6dfd3", modifiers: "Bold")),
            alignment: Right,
        ),
    ],
    header: (
        rows: [
            (
                left: [
                    (kind: Text("["), style: (fg: "#a2b574", modifiers: "Bold")),
                    (kind: Property(Status(StateV2(playing_label: "Playing", paused_label: "Paused", stopped_label: "Stopped"))), style: (fg: "#a2b574", modifiers: "Bold")),
                    (kind: Text("]"), style: (fg: "#a2b574", modifiers: "Bold")),
                ],
                center: [
                    (kind: Property(Song(Title)), style: (modifiers: "Bold"),
                        default: (kind: Text("No Song"), style: (modifiers: "Bold"))
                    )
                ],
                right: [
                    (kind: Text("Vol "), style: (fg: "#a2b574")),
                    (kind: Transform(Replace(content: (kind: Property(Status(Volume))), replacements: [
                    (match: "0", replace: (kind: Text("┈┈┈┈┈┈┈┈┈┈┈┈"))),
                    (match: "5", replace: (kind: Text("━┈┈┈┈┈┈┈┈┈┈┈"))),
                    (match: "10", replace: (kind: Text("━┈┈┈┈┈┈┈┈┈┈┈"))),
                    (match: "15", replace: (kind: Text("━━┈┈┈┈┈┈┈┈┈┈"))),
                    (match: "20", replace: (kind: Text("━━┈┈┈┈┈┈┈┈┈┈"))),
                    (match: "25", replace: (kind: Text("━━━┈┈┈┈┈┈┈┈┈"))),
                    (match: "30", replace: (kind: Text("━━━━┈┈┈┈┈┈┈┈"))),
                    (match: "35", replace: (kind: Text("━━━━┈┈┈┈┈┈┈┈"))),
                    (match: "40", replace: (kind: Text("━━━━━┈┈┈┈┈┈┈"))),
                    (match: "45", replace: (kind: Text("━━━━━┈┈┈┈┈┈┈"))),
                    (match: "50", replace: (kind: Text("━━━━━━┈┈┈┈┈┈"))),
                    (match: "55", replace: (kind: Text("━━━━━━━┈┈┈┈┈"))),
                    (match: "60", replace: (kind: Text("━━━━━━━┈┈┈┈┈"))),
                    (match: "65", replace: (kind: Text("━━━━━━━━┈┈┈┈"))),
                    (match: "70", replace: (kind: Text("━━━━━━━━┈┈┈┈"))),
                    (match: "75", replace: (kind: Text("━━━━━━━━━┈┈┈"))),
                    (match: "80", replace: (kind: Text("━━━━━━━━━━┈┈"))),
                    (match: "85", replace: (kind: Text("━━━━━━━━━━┈┈"))),
                    (match: "90", replace: (kind: Text("━━━━━━━━━━━┈"))),
                    (match: "95", replace: (kind: Text("━━━━━━━━━━━┈"))),
                    (match: "100", replace: (kind: Text("━━━━━━━━━━━━")))
                    ])), style: (fg: "#a2b574")),
                    (kind: Text(" "), style: (fg: "#a2b574")),
                    (kind: Property(Status(Volume)), style: (fg: "#a2b574")),
                    (kind: Text("%"), style: (fg: "#a2b574")),
                ]
            ),
            (
                left: [
                    (kind: Property(Status(Elapsed))),
                    (kind: Text(" / ")),
                    (kind: Property(Status(Duration))),
                    (kind: Text(" (")),
                    (kind: Property(Status(Bitrate))),
                    (kind: Text(" kbps)")),
                ],
                center: [
                    (kind: Property(Song(Artist)), style: (fg: "#dfb26c", modifiers: "Bold"),
                        default: (kind: Text("Unknown"), style: (fg: "#dfb26c", modifiers: "Bold"))
                    ),
                    (kind: Text(" - ")),
                    (kind: Property(Song(Album)), style: (fg: "#a2b574"),
                        default: (kind: Text("Unknown Album"))
                    ),
                ],
                right: [
(kind: Property(Status(RandomV2(
                        on_label: "[x]Random",
                        off_label: "[x]Random",
                        on_style: (fg: "#dfb26c", modifiers: "Bold"),
                        off_style: (fg: "#e6dfd3", modifiers: "Dim"),
                    )))),
                    (kind: Text("  ")),
                    (kind: Property(Status(SingleV2(
                        on_label: "[v]Single",
                        off_label: "[v]Single",
                        oneshot_label: "[v]Single",
                        on_style: (fg: "#dfb26c", modifiers: "Bold"),
                        off_style: (fg: "#e6dfd3", modifiers: "Dim"),
                        oneshot_style: (fg: "#dfb26c", modifiers: "Bold"),
                        off_oneshot_style: (fg: "#e6dfd3", modifiers: "Dim"),
                    )))),
                ]
            ),
        ],
    ),
    cava: (
        bar_width: 1,
        bar_spacing: 2,
        orientation: Bottom,
        bar_color: Gradient({
            0: "#dfb26c",
            33: "#a2b574",
            66: "#e09260",
            100: "#161311"
        })
    ),
    border_symbol_sets: {
        "sharp": (
            top_left: "┌",
            top_right: "┐",
            bottom_left: "└",
            bottom_right: "┘",
            vertical_left: "│",
            vertical_right: "│",
            horizontal_top: "─",
            horizontal_bottom: "─",
        ),
    },
    browser_song_format: [
        (
            kind: Group([
                (kind: Property(Track), style: (fg: "#e6dfd3")),
                (kind: Text(" ")),
            ])
        ),
        (
            kind: Group([
                (kind: Property(Artist), style: (fg: "#e6dfd3")),
                (kind: Text(" - ")),
                (kind: Property(Title), style: (fg: "#e6dfd3")),
            ]),
            default: (kind: Property(Filename), style: (fg: "#e6dfd3"))
        ),
    ],
    layout: Split(
        direction: Vertical,
        panes: [
            (
                pane: Pane(Header),
                size: "4",
                borders: "NONE",
                border_symbols: Library("sharp"),
            ),
            (
                pane: Pane(Tabs),
                size: "0",
                borders: "NONE",
            ),
            (
                pane: Pane(TabContent),
                size: "100%",
            ),
            (
                borders: "NONE",
                size: "1",
                pane: Pane(Empty()),
            ),
            (
                size: "1",
                borders: "NONE",
                pane: Pane(ProgressBar),
            ),
        ],
    ),
)
