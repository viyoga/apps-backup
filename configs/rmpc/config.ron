#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    address: "localhost:6600",
    password: None,
    theme: "custom",
    cache_dir: None,
    on_song_change: ["~/.config/rmpc/fetch_lyrics.sh"],
    volume_step: 5,
    max_fps: 60,
    scrolloff: 0,
    wrap_navigation: false,
    enable_mouse: true,
    lyrics_dir: "/mnt/hdd/Music",
    status_update_interval_ms: 1000,
    select_current_song_on_change: true,
    album_art: (
        method: Auto,
        max_size_px: (width: 1500, height: 1500),
        disabled_protocols: ["http://", "https://"],
        vertical_align: Center,
        horizontal_align: Center,
    ),
    keybinds: (
        global: {
            ":":       CommandMode,
            ",":       VolumeDown,
            ".":       VolumeUp,
            "<Tab>":   NextTab,
            "<S-Tab>": PreviousTab,
            "1":       SwitchToTab("Queue"),
            "2":       SwitchToTab("Directories"),
            "3":       SwitchToTab("Playlists"),
            "q":       Quit,
            ">":       NextTrack,
            "<Space>": TogglePause,
            "<":       PreviousTrack,            "x":       ToggleRandom,
            "v":       ToggleSingleOnOff,
            "b":       SeekBack,
            "f":       SeekForward,
            "[":       SeekBack,
            "]":       SeekForward,
            "?":       ShowHelp,
            "I":       ShowCurrentSongInfo,
            "O":       ShowOutputs,
            "P":       ShowDecoders,
            "u":       Update,
            "U":       Rescan,
        },
        navigation: {
            "k":         Up,
            "j":         Down,
            "h":         Left,
            "l":         Right,
            "<Up>":      Up,
            "<Down>":    Down,
            "<Left>":    Left,
            "<Right>":   Right,
            "<C-k>":     PaneUp,
            "<C-j>":     PaneDown,
            "<C-h>":     PaneLeft,
            "<C-l>":     PaneRight,
            "<C-u>":     UpHalf,
            "<C-d>":     DownHalf,
            "N":         PreviousResult,
            "a":         Add,
            "A":         AddAll,
            "m":         ContextMenu(),
            "r":         Rename,
            "n":         NextResult,
            "g":         Top,
            "s":         Select,
            "<C-Space>": InvertSelection,
            "G":         Bottom,
            "<CR>":      Confirm,
            "i":         FocusInput,
            "J":         MoveDown,
            "K":         MoveUp,
            "/":         EnterSearch,
            "<C-c>":     Close,
            "<Esc>":     Close,
            "D":         Delete,
        },
        queue: {
            "D":       DeleteAll,
            "<CR>":    Play,
            "<C-s>":   Save,
            "a":       AddToPlaylist,
            "d":       Delete,
            "i":       ShowInfo,
            "C":       JumpToCurrent,
        },
    ),
    search: (
        case_sensitive: false,
        mode: Contains,
        search_button: false,
        tags: [
            (value: "any", label: "Any Tag"),
        ],
    ),
    artists: (
        album_display_mode: SplitByDate,
        album_sort_by: Date,
    ),
    cava: (
        framerate: 60,
        autosens: true,
        sensitivity: 110,
        lower_cutoff_freq: 50,
        higher_cutoff_freq: 10000,
        input: (
            method: Fifo,
            source: "/tmp/mpd.fifo",
            sample_rate: 44100,
            channels: 2,
            sample_bits: 16,
        ),
        smoothing: (
            noise_reduction: 40,
            monstercat: true,
            waves: false,
        ),
        eq: []
    ),
    tabs: [
        (
            name: "Queue",
            pane: Split(
                direction: Horizontal,
                panes: [
                    (
                        size: "37%",
                        pane: Split(
                            direction: Vertical,
                            panes: [
                                (
                                    size: "7",
                                    borders: "ALL",
                                    border_symbols: Library("sharp"),
                                    pane: Pane(Lyrics)
                                ),
                                (
                                    size: "100%",
                                    borders: "ALL",
                                    border_symbols: Library("sharp"),
                                    pane: Split(
                                        direction: Horizontal,
                                        panes: [
                                            (size: "1", borders: "NONE", pane: Pane(Empty())),
                                            (size: "100%", borders: "NONE", pane: Pane(AlbumArt)),
                                            (size: "1", borders: "NONE", pane: Pane(Empty())),
                                        ],
                                    ),
                                ),
                            ],
                        ),
                    ),
                    (
                        size: "63%",
                        pane: Split(
                            direction: Vertical,
                            panes: [
                                (
                                    size: "70%",
                                    borders: "ALL",
                                    border_symbols: Library("sharp"),
                                    pane: Split(
                                        direction: Horizontal,
                                        panes: [
                                            (size: "1", borders: "NONE", pane: Pane(Empty())),
                                            (size: "100%", pane: Split(
                                                direction: Vertical,
                                                panes: [
                                                    (size: "2", borders: "BOTTOM", border_symbols: Library("sharp"), pane: Pane(QueueHeader())),
                                                    (size: "100%", borders: "NONE", pane: Pane(Queue)),
                                                ],
                                            )),
                                            (size: "1", borders: "NONE", pane: Pane(Empty())),
                                        ],
                                    ),
                                ),
                                (
                                    size: "30%",
                                    borders: "ALL",
                                    border_symbols: Library("sharp"),
                                    pane: Split(
                                        direction: Horizontal,
                                        panes: [
                                            (size: "1", borders: "NONE", pane: Pane(Empty())),
                                            (size: "100%", borders: "NONE", pane: Pane(Cava)),
                                            (size: "1", borders: "NONE", pane: Pane(Empty())),
                                        ],
                                    ),
                                ),
                            ],
                        )
                    ),
                ],
            ),
        ),
        (
            name: "Directories",
            borders: "ALL",
            border_symbols: Library("sharp"),
            pane: Split(
                size: "100%",
                direction: Vertical,
                panes: [(pane: Pane(Directories), size: "100%", borders: "ALL", border_symbols: Library("sharp"))],
            )
        ),
        (
            name: "Playlists",
            borders: "ALL",
            border_symbols: Library("sharp"),
            pane: Split(
                size: "100%",
                direction: Vertical,
                panes: [(pane: Pane(Playlists), size: "100%", borders: "ALL", border_symbols: Library("sharp"))],
            )
        ),
    ],
)
